# ==============================================================================
# docforge Environment Configuration
# ==============================================================================

# Default Multimodal Model
# Defaults to Ollama cloud model gemma4:cloud (or ollama/gemma4:cloud)
DOCFORGE_MODEL=ollama/gemma4:cloud
# Legacy fallback: PDF2MD_MODEL=ollama/gemma4:cloud

# Ollama Endpoint / Host
# Local default: http://localhost:11434
# For Ollama Cloud or remote deployments, set the base URL and API key/token:
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_API_KEY=

# Commercial Cloud Providers (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Runtime & Caching Configuration Overrides
DOCFORGE_CACHE_DIR=.cache
DOCFORGE_DPI=150
# Legacy fallbacks: PDF2MD_CACHE_DIR=.cache, PDF2MD_DPI=150

# Custom Instructions & Guidelines (optional)
DOCFORGE_INSTRUCTIONS=
DOCFORGE_PROMPT_FILE=
